{
  "name": "vaultify-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' concurrently -k -n server,web \"tsx watch src/server/index.ts\" \"vite\"",
    "start": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' node dist/server/index.js",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "test": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' vitest run",
    "test:e2e": "npm run build && NODE_OPTIONS='--disable-warning=ExperimentalWarning' playwright test",
    "migrate": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' tsx src/server/cli.ts migrate",
    "seed": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' tsx src/server/cli.ts seed",
    "seed:demo": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' tsx src/server/cli.ts seed-demo"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.5",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
