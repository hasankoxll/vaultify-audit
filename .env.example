# Example names and placeholder values only. Replace placeholders locally.
# Do not commit a real .env file.

VA_DATA_DIR=./data
VA_HOST=127.0.0.1
VA_PORT=8787
VA_COOKIE_SECURE=false
VA_SESSION_TTL_HOURS=12
VA_MAX_UPLOAD_BYTES=2000000
VA_MAX_IMPORT_ROWS=5000
VA_ENABLE_DEMO=true
VA_TRUST_PROXY=false
VA_LOGIN_RATE_LIMIT=10
VA_LOGIN_RATE_WINDOW_SECONDS=900

# Used only by `npm run seed`. Rejected if left as this placeholder.
VA_SEED_OWNER_EMAIL=owner@example.com
VA_SEED_OWNER_NAME=Example Owner
VA_SEED_OWNER_PASSWORD=replace-with-a-long-password
VA_SEED_WORKSPACE_NAME=Pilot workspace
